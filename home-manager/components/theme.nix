{
  config,
  inputs,
  pkgs,
  ...
}:
{
  imports = [ inputs.catppuccin.homeModules.catppuccin ];
  catppuccin = {
    enable = true;
    autoEnable = true;
    flavor = "mocha";
    # My Neovim Lua is not generated by Nix
    nvim.enable = false;
  };
  gtk.enable = pkgs.stdenv.hostPlatform.isLinux && !config.dotfiles.headless;
}
